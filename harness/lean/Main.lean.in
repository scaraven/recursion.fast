/-
  Badge executable `{{exe}}` for the submission `{{submission}}` of module `{{module}}`.
  Generated by `python3 -I harness/badge-main.py` from `harness/lean/Main.lean.in` (Stage 6b);
  do not edit. The harness builds it in the gate tree after the gate (DESIGN §7.4 step 3).

  `harness_twin` defines the executable twin of the submission (`RecursionFastHarness/Twin.lean`):
  the same `n`, `shape`, `vkLen`, `VK`, `idxShape`, `IDX`, `verify` terms, executable
  placeholders for the prover, the extractor and the errors (never read by `NARG` or `index`). The
  two theorems below are checked by the kernel when this module is built: the executable runs the
  submission's own `NARG` and `index`.
-/
import RecursionFastHarness
import {{module}}

open RecursionFast

harness_twin harnessP harnessCfg := {{submission}}

/-- The executed verifier is the submission's `NARG`. -/
theorem harnessP_narg (vkc : VKc harnessP.vkLen) (x : Stmt) (t : Tape) :
    NARG harnessCfg harnessP vkc x t = NARG {{submission}}.cfg {{submission}}.P vkc x t := rfl

/-- The executed indexer is the submission's `index`. -/
theorem harnessP_index (L : Layout K) :
    index harnessCfg harnessP L = index {{submission}}.cfg {{submission}}.P L := rfl

{{certified}}
/-- `{{exe}}`: see `RecursionFastHarness.{{entry}}`. -/
def main (args : List String) : IO UInt32 := RecursionFastHarness.{{entry}} harnessCfg harnessP {{entry_args}}args
