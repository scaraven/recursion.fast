/-
  The badge `liveness` (TRUSTED harness code; rendered per entry by `harness/evaluate.py`): the
  extractor liveness check (v3 §8.3 step 8, on the service's query log; a smoke test, never the
  security claim, which is the proved step bound).

    liveness LOG VK_HEX STMT_HEX ROOT_FILE

  The root file must be accepted (`acc`). Then, for the root and recursively for every node's
  children: the entry's extractor program `ext` runs on the compiled contract interpreter
  (`XProg.run`) on the tape `extractorInput c π L`, `L` the service's log of every query it
  evaluated in this run, with the declared fuel `fuel_base + fuel_per_word · t` of the claim; its
  output must decode (`decodeWit`) to a witness of `Rel (acc vk)` at `c`: a leaf whose chain
  ends at `c`, or a node of `c` whose two children `acc` accepts. A run whose declared fuel is
  above `2^36` steps or whose memory is above `2^27` words is not run (v3's liveness caps): the
  output says `ok not run: …`, which the result records. Prints `ok …` or `fail REASON`; exit 0 iff ok.
-/
import RFBadgeCommon

open RecursionFast RFBadge

/-- The declared fuel (rendered from the claim). -/
def declaredFuel (t : Nat) : Nat := {{fuel_base}} + {{fuel_per_word}} * t

/-- The liveness caps: steps and memory words. -/
def stepCap : Nat := 2 ^ 36
def memCap : Nat := 2 ^ 27

/-- Extract at `c` from `π` and check the witness, then recurse into a node's children; the
number of witnesses checked, or why it failed. `depth` bounds the recursion (the tree's depth). -/
def extractCheck (vk : Digest) (L : Log) : Nat → Digest → Proof → Except String Nat
  | 0, _, _ => .error "deeper than the tree"
  | d + 1, c, π => do
    let tape := extractorInput c π L
    let t := tape.length
    if declaredFuel t > stepCap then throw s!"not run: declared fuel {declaredFuel t} above 2^36"
    if S.ext.memFor t > memCap then throw s!"not run: memory {S.ext.memFor t} words above 2^27"
    let some o := S.ext.run tape (declaredFuel t) | throw s!"ext did not halt within the declared fuel ({t} tape words)"
    if o.length > outCap then throw "output above outCap"
    match decodeWit o with
    | none => throw "the output denotes no witness"
    | some (.leaf s n) =>
      if n ≤ chainCap && c == leafStmtF (chainEndF s n) n then return 1
      else throw "a leaf witness not in the relation"
    | some (.node c₁ c₂ p₁ p₂) =>
      if c == nodeStmtF c₁ c₂ && S.accF vk c₁ p₁ && S.accF vk c₂ p₂ then
        return 1 + (← extractCheck vk L d c₁ p₁.π) + (← extractCheck vk L d c₂ p₂.π)
      else throw "a node witness not in the relation"

def main (args : List String) : IO UInt32 := do
  let [logPath, vkh, ch, rootPath] := args
    | IO.eprintln "usage: liveness LOG VK_HEX STMT_HEX ROOT_FILE"; return 2
  let (some vk, some c) := (parseHex32 vkh, parseHex32 ch) | IO.eprintln "liveness: bad hex"; return 2
  let some L := parseLog (← IO.FS.readBinFile logPath) | IO.println "fail the log is malformed"; return 1
  let some root := parseSigned (← IO.FS.readBinFile rootPath) | IO.println "fail the root file is malformed"; return 1
  unless S.accF vk c root do IO.println "fail the root is not accepted"; return 1
  match extractCheck vk L 64 c root.π with
  | .ok k => IO.println s!"ok extracted and checked {k} witnesses from a log of {L.length} entries"; return 0
  | .error e =>
    if e.startsWith "not run" then IO.println s!"ok {e}"; return 0   -- v3: "node liveness not run"
    IO.println s!"fail {e}"; return 1
