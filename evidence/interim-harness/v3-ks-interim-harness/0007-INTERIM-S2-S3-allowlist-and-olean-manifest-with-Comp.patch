diff --git a/scripts/org-closure.sh b/scripts/org-closure.sh
new file mode 100755
index 0000000..7951629
--- /dev/null
+++ b/scripts/org-closure.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# INTERIM (stage S2/S3 organiser work on the scratch branch `v3/ks-interim-harness`; S3 owns the
+# real harness): the import allowlist (gate rule 6) and the olean manifest (gate rule 5, harness
+# stage 0) of a clean organiser build, generated after `scripts/setup-scratch.sh org`:
+#
+#   scripts/org-closure.sh OUTDIR     writes OUTDIR/import-allowlist.txt and OUTDIR/olean-manifest.sha256
+#
+# Roots of the closure: Mathlib, the contract, the organiser library and controls (v2's
+# `org-build.sh`), and CompPoly's BF64/Ext3 closure, which the design admits for entries
+# (DESIGN-v3 §7.4, V3-9; AGENTS.md §10): `CompPoly.Fields.Binary.BF64` and its submodules `Basic`,
+# `Bytes`, `Ext3`, `Impl`, `Reduce`, `BaseCertificate`. Its modules are then *pinned* by hash
+# (`olean-manifest.py`'s PINNED_PKGS), so the gate reports, rather than rejects, the `@[csimp]`
+# lemma CompPoly registers (`CompPoly.Fields.Extension.Arithmetic`).
+set -euo pipefail
+DIR=$(cd "$(dirname "$0")/.." && pwd); OUT=$(mkdir -p "${1:?usage: org-closure.sh OUTDIR}" && cd "$1" && pwd)
+ROOTS=Mathlib,RecursionFast.Contract,RecursionFast.Library,RecursionFast.Controls
+for m in "" .Basic .Bytes .Ext3 .Impl .Reduce .BaseCertificate; do ROOTS="$ROOTS,CompPoly.Fields.Binary.BF64$m"; done
+cd "$DIR"
+timeout "${TIMEOUT:-3600}" lake exe gate --closure "$ROOTS" "$OUT/import-allowlist.txt" 2>&1 | tail -1
+python3 -I scripts/olean-manifest.py gen "$OUT/olean-manifest.sha256" --org "$DIR" --closure "$OUT/import-allowlist.txt" 2>&1 | tail -1
