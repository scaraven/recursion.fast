+#!/usr/bin/env bash
+# Prepare and build THIS clone of the core for an entry's local checks (INTERIM, stage S2a, on the
+# scratch branch `v3/s2-interim-harness`; S3 replaces it). Only the clone is written to.
+#
+#   scripts/setup-scratch.sh entry ENTRY_ROOT [RUN_MODULE]
+#                                               add a `[[lean_lib]]` of the flat entry root (srcDir: a
+#                                               symbolic link `entry` to it; every `*.lean` file a
+#                                               root) and, with RUN_MODULE, a `[[lean_exe]]`
+#                                               `entry-run` rooted there; build them, `gate` and
+#                                               `axiomaudit`
+#   scripts/setup-scratch.sh org                the clean organiser package: the core's default
+#                                               targets and `gate` only, no entry module
+#
+# The Lean tree must be the pin's: `git diff --name-only PIN HEAD` may name only the interim
+# organiser files of this branch (PIN: an environment variable, the submissions repository's
+# `.contract` pin). Packages: PACKAGES (default: this machine's shared, prebuilt,
+# read-only tree) is linked as .lake/packages; never `lake update` or `lake exe cache get` against
+# it; with PACKAGES='' the script runs `lake exe cache get`. Builds run under `timeout` (TIMEOUT
+# seconds, default 3600).
+set -euo pipefail
+DIR=$(cd "$(dirname "$0")/.." && pwd); cd "$DIR"
+MODE=${1:?usage: setup-scratch.sh entry ENTRY_ROOT [RUN_MODULE] | org}
+PACKAGES=${PACKAGES-/home/devops/CambridgePQ/recursion.fast/contract/.lake/packages}
+TIMEOUT=${TIMEOUT:-3600}
+PIN=${PIN:?setup-scratch: set PIN to the pinned core commit}
+INTERIM="RecursionFast/Challenge/V3.lean.in scripts/harness-local.sh scripts/render-challenge.py scripts/setup-scratch.sh"
+for f in $(git diff --name-only "$PIN" HEAD); do
+  [[ " $INTERIM " == *" $f "* ]] || { echo "setup-scratch: $f differs from the pin $PIN" >&2; exit 1; }
+done
+git diff --quiet HEAD -- . ':!lakefile.toml' || { echo "setup-scratch: uncommitted changes in $DIR" >&2; exit 1; }
+if [[ ! -e .lake/packages ]]; then
+  mkdir -p .lake
+  if [[ -n "$PACKAGES" ]]; then ln -s "$PACKAGES" .lake/packages; else timeout "$TIMEOUT" lake exe cache get; fi
+fi
+if [[ $MODE == entry ]]; then
+  ROOT=$(cd "${2:?usage: setup-scratch.sh entry ENTRY_ROOT [RUN_MODULE]}" && pwd); RUN=${3:-}
+  [[ -L entry ]] || ln -s "$ROOT" entry
+  [[ "$(readlink entry)" == "$ROOT" ]] || { echo "setup-scratch: entry links elsewhere" >&2; exit 1; }
+  git checkout -q lakefile.toml
+  mods=$(cd "$ROOT" && ls *.lean | sed 's/\.lean$//' | python3 -I -c 'import sys,json; print(json.dumps(sys.stdin.read().split()))')
+  printf '\n# entry (setup-scratch.sh): scratch only, never committed\n[[lean_lib]]\nname = "EntryScratch"\nsrcDir = "entry"\nroots = %s\n' "$mods" >> lakefile.toml
+  [[ -z "$RUN" ]] || printf '\n[[lean_exe]]\nname = "entry-run"\nsrcDir = "entry"\nroot = "%s"\n' "$RUN" >> lakefile.toml
+  timeout "$TIMEOUT" lake build gate axiomaudit EntryScratch ${RUN:+entry-run} 2>&1 | grep -E "^(error|warning)|Build completed|^✖" || true
+  timeout "$TIMEOUT" lake build EntryScratch ${RUN:+entry-run} > /dev/null 2>&1 || { echo "setup-scratch: entry build failed" >&2; exit 1; }
+else
+  git diff --quiet HEAD || { echo "setup-scratch: $DIR has local changes; the organiser package must be the branch" >&2; exit 1; }
+  timeout "$TIMEOUT" lake build 2>&1 | grep -E "^(error|warning)|Build completed|^✖" || true
+  timeout "$TIMEOUT" lake build gate 2>&1 | grep -E "^(error|warning)|Build completed|^✖" || true
+  [[ -x .lake/build/bin/gate ]] || { echo "setup-scratch: organiser build failed" >&2; exit 1; }
+fi
+echo "setup-scratch: $MODE at $(git rev-parse --short HEAD) (pin $PIN) in $DIR"
