/-
  Challenge stub, board R (the recursion board, DESIGN §5, §6.2), rendered by
  `python3 -I scripts/render-challenge.py R.lean.in claim.json OUT.lean` (strict schema, A4-F5;
  v2 placeholders, Stage 6b). Everything except `submission` is organiser data (A4-F2):

  * the extractor image, rendered from the submitted raw `.code`/`.data` files (S4-A2, S7-A1);
  * the submitted recursion layout `C_V` as a literal `C`, rendered from its layout JSON (the
    `layout` placeholder, harness/render-layout.py's emitter); the badge path's indexer reads the
    same file, so the key digest it computes is the digest of this `C` (S5-A13);
  * the declared claim (`DeclaredR`): class, hash, arity, the extractor image (certified,
    `Certificate.img`, S7-A1), the chip and matrix-entry counts of `C` (certified,
    `CertificateR.size`; the renderer also checks them against the layout) and the two key
    digests `digestC = D (index cfg P C)` and `digestL = D (index cfg P L_chain(2^10))`, which
    are NOT certified (committing an index oracle is beyond the kernel): the harness recomputes both
    with the compiled indexer and rejects a claim that differs (S5-A3, S5-A13).

  The comparator checks that the solution proves exactly `certified`, with `leaf` and `submission`
  as the entries of `definition_names`; the gate then requires compiled code for the badge-path
  fields of `submission`, `entry.C` and `entry.decode` included (S5-A9), and builds the badge
  executables from `leaf`'s module, which must not reach Clean (rules 8, 9; S6b-A11).
-/
import RecursionFast.Contract
import Mathlib.Data.Fin.VecNotation

namespace RecursionFast.Challenge
open RecursionFast

{{image:image}}

{{layout:C}}

/-- The declared claim (rendered). -/
def declared : DeclaredR :=
  { k := {{nat:k}}, hash := {{hash:hash}}, arity := {{nat:arity}}, img := image,
    chips := {{nat:C.chips}}, entries := {{nat:C.entries}}, digestC := {{digest:digestC}},
    digestL := {{digest:digestL}} }

/-- The protocol part (provided by the solution): the leaf-board submission the badge
executables are built from. It must be declared in a module that does not import the circuit
frontend (Clean) or anything outside the gate's compiler-free closure (gate rule 8, S6b-A11). -/
def leaf : Submission declared.k := sorry

/-- The submission (provided by the solution): `leaf` and its recursion entry, the verifier as a
circuit at the protocol's own class (its proofs may import Clean). -/
def submission : SubmissionR declared.k := sorry

/-- **The certificate**: the configuration and the size of `C_V` are the declared ones, the
extractor image is the rendered one, the recursion layout is the rendered `C`, and the
submission's protocol part is `leaf`. -/
theorem certified : CertificateR declared submission ∧ submission.entry.C = C ∧
    submission.toSubmission = leaf := sorry

end RecursionFast.Challenge
