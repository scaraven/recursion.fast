#!/usr/bin/env python3
"""The token broker (rf-jit.service; user `rfjit`; stdlib only): the only process that holds the
GitHub token. The slot supervisors (user `rfrunner`) and their VMs never see it.

It listens on the Unix socket /run/rf-jit/jit.sock and serves one JSON request per connection
(at most MAX_CONN at a time and MAX_PER_PEER per uid, so that no slot can starve another), only to peers whose uid (SO_PEERCRED) is a slot's user (slots.json
"user"); the uid decides the slot, never the request:
  {"op": "jitconfig"[, "slot": S]} -> {"ok": true, "id": N, "name": "rf-S-UUID", "jit": "..."}
      a just-in-time runner registration for the peer's slot S, with S's labels from slots.json
      (the client cannot choose a slot, a name or labels; a request naming another slot is
      refused); at most RATE_SLOT per slot and RATE_ALL in all per hour
  {"op": "delete", "id": N}        -> {"ok": true, "status": "deleted" | "gone" | "queued"}
      only for ids this broker issued to the peer's slot; a deletion that fails is queued and
      retried every minute
An escape from a VM or a supervisor can therefore at most register a few more runners of its
own slot's labels, and delete its own slot's runners.
At start it deletes the offline runners named rf-* (left by a crash or a power cut).
State (issued ids, pending deletions): /var/lib/rf-jit/state.json.
"""
import json
import os
import pwd
import socket
import struct
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid

CONF = os.environ.get("RF_CONF", "/opt/rf-runner/slots.json")
SOCK = "/run/rf-jit/jit.sock"
STATE = "/var/lib/rf-jit/state.json"
API = "https://api.github.com"
RATE_SLOT, RATE_ALL = 30, 60
MAX_CONN, MAX_PER_PEER = 8, 2
lock = threading.Lock()
slots_busy = threading.BoundedSemaphore(MAX_CONN)
per_peer = {}             # uid -> open connections (under `lock`)
_refusals = {}            # (uid, why) -> [time of the last journal line, refusals since] (under `lock`)


def refused(uid, why):
    """A refused connection, in the journal at most once a minute per (uid, reason), with the
    number of refusals the minute before suppressed; entries older than ten minutes are dropped."""
    t = time.monotonic()
    lost = []
    with lock:
        for k in [k for k, (last, _) in _refusals.items() if t - last > 600]:
            if _refusals[k][1]:
                lost.append((k, _refusals[k][1]))   # suppressed refusals that never got their line
            del _refusals[k]
        last, n = _refusals.get((uid, why), (-1e9, 0))
        if t - last < 60:
            _refusals[(uid, why)] = [last, n + 1]
            n = None
        else:
            _refusals[(uid, why)] = [t, 0]
    for (u, w), m in lost:
        log(f"refused {m} more connection(s) from uid {u}: {w} (counted until the entry expired)")
    if n is not None:
        log(f"refused a connection from uid {uid}: {why}" + (f" ({n} more since the last such line)" if n else ""))


def log(msg):
    print(msg, flush=True)


class GitHubError(Exception):
    def __init__(self, status, msg):
        super().__init__(f"HTTP {status}: {msg}")
        self.status = status


class GitHub:
    def __init__(self, repo):
        cred = os.environ.get("CREDENTIALS_DIRECTORY")
        if not cred:
            raise SystemExit("rf-jit: no credential directory (run from rf-jit.service)")
        with open(os.path.join(cred, "github-token")) as f:
            self._token = f.read().strip()
        if not self._token:
            raise SystemExit("rf-jit: the github-token credential is empty")
        self.repo = repo

    def req(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        r = urllib.request.Request(API + path, data=data, method=method, headers={
            "Authorization": f"Bearer {self._token}", "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "rf-jit"})
        try:
            with urllib.request.urlopen(r, timeout=30) as resp:
                raw = resp.read()
                return json.loads(raw) if raw else None
        except urllib.error.HTTPError as e:
            raise GitHubError(e.code, e.read()[:300].decode(errors="replace")) from None
        except (urllib.error.URLError, socket.timeout, OSError) as e:
            raise GitHubError(0, str(e)) from None

    def delete(self, rid):
        try:
            self.req("DELETE", f"/repos/{self.repo}/actions/runners/{rid}")
            return "deleted"
        except GitHubError as e:
            if e.status == 404:
                return "gone"
            raise

    def runners(self):
        out, page = [], 1
        while True:
            d = self.req("GET", f"/repos/{self.repo}/actions/runners?per_page=100&page={page}")
            out += d["runners"]
            if len(d["runners"]) < 100:
                return out
            page += 1


def load():
    try:
        s = json.load(open(STATE))
    except (OSError, ValueError):
        s = {}
    s.setdefault("issued", {})
    s.setdefault("pending", [])
    s.setdefault("times", [])
    return s


def save(s):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f)
    os.replace(tmp, STATE)


class Broker:
    def __init__(self):
        self.conf = json.load(open(CONF))
        self.gh = GitHub(self.conf["repo"])
        self.state = load()

    def jitconfig(self, slot):
        if slot not in self.conf["slots"]:
            return {"ok": False, "error": f"unknown slot {slot!r}"}
        now = time.time()
        with lock:
            t = [x for x in self.state["times"] if now - x[1] < 3600]
            if len([x for x in t if x[0] == slot]) >= RATE_SLOT or len(t) >= RATE_ALL:
                return {"ok": False, "error": "rate limit: too many registrations in the last hour"}
            self.state["times"] = t + [[slot, now]]
            save(self.state)
        name = f"rf-{slot}-{uuid.uuid4()}"
        s = self.conf["slots"][slot]
        try:
            d = self.gh.req("POST", f"/repos/{self.gh.repo}/actions/runners/generate-jitconfig",
                            {"name": name, "runner_group_id": self.conf["runner_group_id"],
                             "labels": s["labels"], "work_folder": "_work"})
        except GitHubError as e:
            return {"ok": False, "error": str(e), "status": e.status}
        rid = d["runner"]["id"]
        with lock:
            self.state["issued"][str(rid)] = {"slot": slot, "name": name, "at": now}
            # keep the issued list bounded (ids older than a week are long deleted)
            self.state["issued"] = {k: v for k, v in self.state["issued"].items() if now - v["at"] < 7 * 86400}
            save(self.state)
        log(f"issued {name} (id {rid})")
        return {"ok": True, "id": rid, "name": name, "jit": d["encoded_jit_config"]}

    def delete(self, rid, slot):
        key = str(rid)
        with lock:
            if self.state["issued"].get(key, {}).get("slot") != slot:
                return {"ok": False, "error": f"runner {rid} was not issued to slot {slot}"}
        try:
            st = self.gh.delete(rid)
        except GitHubError as e:
            with lock:
                if rid not in self.state["pending"]:
                    self.state["pending"].append(rid)
                save(self.state)
            log(f"delete {rid}: {e}; queued")
            return {"ok": True, "status": "queued"}
        log(f"runner {rid}: {st}")
        return {"ok": True, "status": st}

    def retry_loop(self):
        while True:
            time.sleep(60)
            with lock:
                pend = list(self.state["pending"])
            for rid in pend:
                try:
                    st = self.gh.delete(rid)
                except GitHubError:
                    continue
                log(f"queued deletion of {rid}: {st}")
                with lock:
                    self.state["pending"].remove(rid)
                    save(self.state)

    def cleanup(self):
        try:
            for r in self.gh.runners():
                if r["name"].startswith("rf-") and r["status"] == "offline":
                    log(f"removing stale runner {r['name']} ({self.gh.delete(r['id'])})")
        except GitHubError as e:
            log(f"could not list runners: {e}")


def serve(b):
    uids = {}
    for name, s in b.conf["slots"].items():
        try:
            uids[pwd.getpwnam(s["user"]).pw_uid] = name
        except KeyError:
            log(f"no user {s['user']} for slot {name}")
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)  # anyone may connect; only rfrunner's uid is served (SO_PEERCRED)
    srv.listen(16)
    log(f"listening on {SOCK}")
    while True:
        c, _ = srv.accept()
        try:
            uid = struct.unpack("3i", c.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[1]
        except OSError:
            c.close()
            continue
        if uid not in uids:
            refused(uid, "not a slot's user")
            c.close()  # before any cap is touched: only a slot's user takes a connection
            continue
        with lock:
            full = per_peer.get(uid, 0) >= MAX_PER_PEER
            if not full:
                per_peer[uid] = per_peer.get(uid, 0) + 1
        if full:
            refused(uid, f"{MAX_PER_PEER} requests of this slot already open")
            c.close()  # this uid has MAX_PER_PEER requests open: refuse, never queue
            continue
        if not slots_busy.acquire(blocking=False):
            release_peer(uid)
            refused(uid, f"{MAX_CONN} requests already open")
            c.close()  # MAX_CONN requests are being served: refuse, never queue
            continue
        try:
            threading.Thread(target=handle, args=(b, c, uids, uid), daemon=True).start()
        except RuntimeError:
            slots_busy.release()
            release_peer(uid)
            c.close()


def release_peer(uid):
    with lock:
        per_peer[uid] -= 1


def handle(b, c, uids, uid):
    try:
        serve_one(b, c, uids)
    except Exception as e:  # noqa: BLE001 - one bad request never stops the broker
        log(f"request failed: {type(e).__name__}")
    finally:
        c.close()
        slots_busy.release()
        release_peer(uid)


def serve_one(b, c, uids):
    with c:
        c.settimeout(20)
        pid, uid, gid = struct.unpack("3i", c.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        slot = uids.get(uid)
        if slot is None:
            log(f"refused a peer with uid {uid} (pid {pid})")
            return
        try:
            data = b""
            while not data.endswith(b"\n") and len(data) < 4096:
                chunk = c.recv(4096)
                if not chunk:
                    break
                data += chunk
            req = json.loads(data)
            if not isinstance(req, dict):
                resp = {"ok": False, "error": "bad request"}
            elif req.get("op") == "jitconfig":
                if req.get("slot", slot) != slot:
                    log(f"refused: uid {uid} (slot {slot}) asked for slot {str(req.get('slot'))[:20]!r}")
                    resp = {"ok": False, "error": f"this peer is slot {slot}, not {str(req.get('slot'))[:20]!r}"}
                else:
                    resp = b.jitconfig(slot)
            elif req.get("op") == "delete" and isinstance(req.get("id"), int):
                resp = b.delete(req["id"], slot)
            else:
                resp = {"ok": False, "error": "unknown request"}
        except (ValueError, OSError) as e:
            resp = {"ok": False, "error": f"bad request: {e}"}
        try:
            c.sendall(json.dumps(resp).encode() + b"\n")
        except OSError:
            pass


def main():
    b = Broker()
    b.cleanup()
    threading.Thread(target=b.retry_loop, daemon=True).start()
    serve(b)


if __name__ == "__main__":
    sys.exit(main())
