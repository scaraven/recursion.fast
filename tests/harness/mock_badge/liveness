#!/usr/bin/python3 -I
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mock_acc as M, signed
log, vk, c, f = sys.argv[1], bytes.fromhex(sys.argv[2]), bytes.fromhex(sys.argv[3]), sys.argv[4]
entries = len(open(log, "rb").read())
def extract(c, s, depth):
    w = M.decode(s.pi) if s else None          # E c π L := decode π (witness-sending)
    if w is None:
        return f"no witness at depth {depth}"
    if w[0] == "leaf":
        return None if w[2] <= M.CHAIN_CAP and c == M.leaf_stmt(M.chain_end(w[1], w[2]), w[2]) else "leaf witness not in Rel"
    if not (c == M.node_stmt(w[1], w[2]) and M.acc_signed(vk, w[1], w[3]) and M.acc_signed(vk, w[2], w[4])):
        return "node witness not in Rel"
    return extract(w[1], w[3], depth + 1) or extract(w[2], w[4], depth + 1)
err = extract(c, signed.parse(open(f, "rb").read()), 0)
print(f"fail {err}" if err else f"ok extracted the tree from a log of {entries} bytes (mock)")
sys.exit(1 if err else 0)
