#!/usr/bin/python3 -I
# The Python stand-in for the badge `verify` (mock_acc.py): `--serve` (the runner's mode, one
# request per line of standard input, each answered before the next is read) and `--batch LIST`.
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mock_acc


def answer(line):
    vk, c, path = line.split()
    data = open(path, "rb").read()
    t0 = time.monotonic_ns()
    ok = mock_acc.acc(bytes.fromhex(vk), bytes.fromhex(c), data)
    print("accept" if ok else "reject", time.monotonic_ns() - t0, flush=True)


if sys.argv[1:] == ["--serve"]:
    for line in sys.stdin:
        if line.strip():
            answer(line)
else:
    assert sys.argv[1] == "--batch"
    for line in open(sys.argv[2]):
        answer(line)
