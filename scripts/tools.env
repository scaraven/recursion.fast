# The pins of the two kernels the harness runs (v3, kept by v4). `harness/evaluate.py` reads
# COMPARATOR_HOME, COMPARATOR_LEAN4EXPORT and COMPARATOR_NANODA from the environment: source this
# file on the development machine; CI builds the pinned checkouts (`harness/ci/build-kernels.sh`).
# Binaries are never in git. A variable already set in the environment wins.
#
#   COMPARATOR_HOME    leanprover/comparator at d03acab (https://github.com/leanprover/comparator),
#                      built: `lake build` (its lean4export package, leanprover/lean4export at
#                      076e8e5, is built by `lake build lean4export` in the same checkout)
#   COMPARATOR_NANODA  nanoda_bin of ammkrn/nanoda_lib at 3a24072 (https://github.com/ammkrn/nanoda_lib),
#                      built: `cargo build --release` (target/release/nanoda_bin)
#
# The defaults below are this development machine's checkouts; on another machine set both
# variables.
[[ -n "${COMPARATOR_HOME:-}" ]] || {
  d=/home/devops/CambridgePQ/recursion.fast/contract/tools/comparator
  [[ -x "$d/.lake/build/bin/comparator" ]] && export COMPARATOR_HOME=$d
}
[[ -n "${COMPARATOR_NANODA:-}" ]] || {
  d=/home/devops/CambridgePQ/recursion.fast/contract-v03/tools/ext/nanoda_lib/target/release/nanoda_bin
  [[ -x "$d" ]] && export COMPARATOR_NANODA=$d
}
unset d
