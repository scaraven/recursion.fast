# The two kernels' tools for `harness/evaluate.py cert`, which reads COMPARATOR_HOME,
# COMPARATOR_LEAN4EXPORT and COMPARATOR_NANODA from the environment. A variable already set wins.
# Binaries are never in git.
#
# The pins are in `harness/ci/build-kernels.sh`, which builds them (CI uses it):
#   COMPARATOR_HOME    leanprover/comparator at d03acab, its `lean-toolchain` replaced by this
#                      repository's (v4.34.1; a lean4export of another Lean cannot read the oleans),
#                      with its lean4export package (leanprover/lean4export at 076e8e5)
#   COMPARATOR_NANODA  nanoda_bin of ammkrn/nanoda_lib at 3a24072 (only with RF_NANODA=1)
#
# Either export what build-kernels.sh prints:
#   set -a; eval "$(harness/ci/build-kernels.sh "$HOME/rf-kernels")"; set +a
# or set RF_KERNELS to the directory build-kernels.sh filled and source this file.
if [[ -n "${RF_KERNELS:-}" ]]; then
  [[ -n "${COMPARATOR_HOME:-}" ]] || export COMPARATOR_HOME="$RF_KERNELS/comparator"
  [[ -n "${COMPARATOR_NANODA:-}" || ! -x "$RF_KERNELS/nanoda_lib/target/release/nanoda_bin" ]] ||
    export COMPARATOR_NANODA="$RF_KERNELS/nanoda_lib/target/release/nanoda_bin"
fi
